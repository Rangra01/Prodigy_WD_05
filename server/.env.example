# ------------------------------------------------------------
# Server configuration — copy this file to .env and fill in real
# values. Never commit the real .env file to Git.
#   cp server/.env.example server/.env
# ------------------------------------------------------------

# Port the API server listens on
PORT=3000

# MySQL connection (must match database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=social_media_db

# Secret used to sign JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# How long a session stays valid (jsonwebtoken syntax)
JWT_EXPIRES_IN=1d

# Where the React client runs (comma-separated list allowed).
# Used for CORS and CSRF (origin) checks.
CLIENT_URL=http://localhost:5173

# Set to 1 only when running behind a reverse proxy (nginx, Heroku, ...)
# so rate limiting sees real client IPs.
TRUST_PROXY=0

# NODE_ENV is "development" locally and "production" on a server.
# In production, auth cookies are marked Secure (HTTPS required).
NODE_ENV=development

# ------------------------------------------------------------
# Optional: Cloudinary image uploads.
# Leave blank to run without image uploads (text-only posts and
# profile initials still work fine).
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
