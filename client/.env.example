# ------------------------------------------------------------
# Client configuration — copy to .env only if you need it.
#   cp client/.env.example client/.env
# ------------------------------------------------------------

# Optional absolute API base URL.
# Leave unset in development: the Vite dev server proxies /api to
# http://localhost:3000 (see vite.config.js), which also keeps the
# HTTP-only auth cookie working without CORS issues.
# Only set this when the backend runs on a different origin,
# e.g. VITE_API_URL=https://api.example.com/api
VITE_API_URL=
